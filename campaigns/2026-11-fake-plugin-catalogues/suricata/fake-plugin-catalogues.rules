# Domains: the same domains in the Host header of a clear-text HTTP request (when DNS is not visible: external resolver or DoH)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"PLUGINDEX campaign domain HTTP Host plugin-dex.com"; flow:established,to_server; http.host; dotprefix; content:".plugin-dex.com"; endswith; nocase; fast_pattern; classtype:trojan-activity; sid:9100124; rev:1; metadata:created_at 2026_11_09, confidence High, signature_severity Major;)
