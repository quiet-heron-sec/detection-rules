# Suricata 7 rules: fake plugin catalogues (PluginDex, AnyPlugins), hhunter implant, RuntimeBroker payload
# Author: quiet-heron-sec. SID range 9100001 to 9100199 reserved, 46 rules in use (9100001 to 9100135). License: Creative Commons Attribution 4.0 (CC BY 4.0).
# Tested on Suricata 7.0.10 with crafted, harmless traffic in an isolated network (positive and negative cases for every SID),
# then 10 minutes of scripted clean traffic with no alert. No live campaign traffic was replayed.

# RuntimeBroker payload (Plugin_Setup 4.6.5 and 4.6.8): clear-text WebSocket to TCP port 406 using the RFC 6455 example key.
# The pattern comes from emulating the payload, it has not been seen on a real network. The emulated request also raises 9100134, because its Host header is a campaign domain.
alert http $HOME_NET any -> $EXTERNAL_NET 406 (msg:"PLUGINDEX RuntimeBroker payload WebSocket upgrade with RFC 6455 example key to TCP 406"; flow:established,to_server; http.method; content:"GET"; http.header; content:"dGhlIHNhbXBsZSBub25jZQ=="; fast_pattern; content:"sec-websocket-key"; nocase; content:"websocket"; nocase; classtype:trojan-activity; sid:9100001; rev:1; metadata:created_at 2026_11_09, confidence Medium, signature_severity Major;)

# RuntimeBroker payload, hunting: any WebSocket handshake that reuses the RFC 6455 example key (code copied from the standard), any port
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"HUNTING WebSocket upgrade using RFC 6455 example Sec-WebSocket-Key"; flow:established,to_server; http.header; content:"dGhlIHNhbXBsZSBub25jZQ=="; fast_pattern; content:"sec-websocket-key"; nocase; classtype:bad-unknown; sid:9100002; rev:1; metadata:created_at 2026_11_09, confidence Low, signature_severity Minor;)

# hhunter VNC tunnel: TLS certificate (seen by Censys on 91.92.43.209:7000).
# Fires on TLS 1.2 only. No alert on TLS 1.3 (certificate encrypted) or on a resumed TLS 1.2 session.
alert tls $EXTERNAL_NET any -> $HOME_NET any (msg:"HHUNTER VNC tunnel TLS certificate CN=hhunter-vnc"; flow:established,to_client; tls.cert_subject; content:"CN=hhunter-vnc"; fast_pattern; pcre:"/(?:^|, )CN=hhunter-vnc(?:,|$)/"; classtype:trojan-activity; sid:9100003; rev:2; metadata:created_at 2026_11_09, confidence High, signature_severity Major;)

# ClickFix: kit download URL (/clickfix/<10-character token>/file), visible in clear-text HTTP (port 8081 observed)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"PLUGINDEX ClickFix kit payload download URI"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/clickfix/"; startswith; fast_pattern; pcre:"/^\/clickfix\/[A-Za-z0-9_-]{10}\/file(?:\?|$)/"; classtype:trojan-activity; sid:9100004; rev:1; metadata:created_at 2026_11_09, confidence Medium, signature_severity Major;)

# ClickFix, hunting: PowerShell downloading a .ps1 script (generic ClickFix pattern). May overlap with Emerging Threats rules, not checked
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"HUNTING PowerShell user-agent fetching a .ps1 script"; flow:established,to_server; http.user_agent; content:"WindowsPowerShell/"; fast_pattern; http.uri; content:".ps1"; nocase; pcre:"/\.ps1(?:\?|$)/i"; threshold:type limit, track by_src, count 1, seconds 3600; classtype:bad-unknown; sid:9100005; rev:1; metadata:created_at 2026_11_09, confidence Low, signature_severity Minor;)

# Archive download: the malicious archive, visible only behind a TLS-inspecting proxy (sites served over HTTPS behind Cloudflare).
# The /go/ page with an encoded archive path can raise 9100006 and 9100007 together, because http.uri is normalized.
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"PLUGINDEX fake plugin catalogue Plugin_Setup archive download"; flow:established,to_server; http.uri; content:"/downloads/Plugin_Setup_"; fast_pattern; content:".zip"; nocase; pcre:"/\.zip(?:\?|$)/i"; classtype:trojan-activity; sid:9100006; rev:1; metadata:created_at 2026_11_09, confidence Medium, signature_severity Major;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"PLUGINDEX fake plugin catalogue /go/ download redirect page"; flow:established,to_server; http.uri; content:"/go/?n="; startswith; fast_pattern; content:"&u="; content:"Plugin_Setup"; classtype:trojan-activity; sid:9100007; rev:1; metadata:created_at 2026_11_09, confidence Medium, signature_severity Major;)

# Servers: known command and download servers. Short-lived indicators, remove them once the servers are taken down.
# Tested only on crafted captures that included a data packet after the handshake.
alert tcp $HOME_NET any -> 93.152.209.8 [7000,8443,9443,9445] (msg:"HHUNTER known C2 or panel 93.152.209.8"; flow:established,to_server; threshold:type limit, track by_src, count 1, seconds 3600; classtype:trojan-activity; sid:9100010; rev:1; metadata:created_at 2026_11_09, confidence High, signature_severity Major;)
alert tcp $HOME_NET any -> 91.92.43.209 [7000,8081,9443] (msg:"HHUNTER known C2, panel or ClickFix server 91.92.43.209"; flow:established,to_server; threshold:type limit, track by_src, count 1, seconds 3600; classtype:trojan-activity; sid:9100011; rev:1; metadata:created_at 2026_11_09, confidence High, signature_severity Major;)
alert tcp $HOME_NET any -> 65.108.207.11 8093 (msg:"HHUNTER next-stage server 65.108.207.11:8093 (build of 4 Nov 2026)"; flow:established,to_server; threshold:type limit, track by_src, count 1, seconds 3600; classtype:trojan-activity; sid:9100012; rev:1; metadata:created_at 2026_11_09, confidence Medium, signature_severity Major;)

# Domains: campaign domains in DNS queries and TLS SNI, subdomains included (bare domain and www. tested, lookalike suffixes do not fire)
alert dns $HOME_NET any -> any any (msg:"PLUGINDEX campaign domain DNS query plugin-dex.com"; dns.query; dotprefix; content:".plugin-dex.com"; endswith; nocase; fast_pattern; classtype:trojan-activity; sid:9100100; rev:1; metadata:created_at 2026_11_09, confidence High, signature_severity Major;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"PLUGINDEX campaign domain TLS SNI plugin-dex.com"; flow:established,to_server; tls.sni; dotprefix; content:".plugin-dex.com"; endswith; nocase; fast_pattern; classtype:trojan-activity; sid:9100101; rev:1; metadata:created_at 2026_11_09, confidence High, signature_severity Major;)
alert dns $HOME_NET any -> any any (msg:"PLUGINDEX campaign domain DNS query plugin-dex.asia"; dns.query; dotprefix; content:".plugin-dex.asia"; endswith; nocase; fast_pattern; classtype:trojan-activity; sid:9100102; rev:1; metadata:created_at 2026_11_09, confidence High, signature_severity Major;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"PLUGINDEX campaign domain TLS SNI plugin-dex.asia"; flow:established,to_server; tls.sni; dotprefix; content:".plugin-dex.asia"; endswith; nocase; fast_pattern; classtype:trojan-activity; sid:9100103; rev:1; metadata:created_at 2026_11_09, confidence High, signature_severity Major;)
